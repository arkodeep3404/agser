# Agser platform — copy to .env and adjust. Every knob the server supports.

# ---- Platform access --------------------------------------------------------
# Shared API key clients send (x-api-key or Bearer)
PLATFORM_API_KEY=dev-key
# CORS origins for browser clients (default *)
# CORS_ALLOW_ORIGINS=https://app.example.com

# ---- Data stores (set automatically in compose/CDK; override for external) --
# DATABASE_URI=postgres://user:pass@host:5432/langgraph
# REDIS_URI=redis://host:6379
# LANGGRAPH_POSTGRES_POOL_MAX_SIZE=150
# REDIS_MAX_CONNECTIONS=500

# ---- Encryption at rest ----------------------------------------------------
# 16/24/32-byte key; encrypts checkpoints (and JSON_KEYS fields if set)
# LANGGRAPH_AES_KEY=change-me-32-bytes-long-or-24b-or-16!!
# LANGGRAPH_AES_JSON_KEYS=metadata,config

# ---- Inference provider (choose; not hardcoded) ----------------------------
# bedrock (in-account IAM) | direct provider string via AGENT_MODEL
MODEL_PROVIDER=openrouter
AGENT_MODEL=anthropic:claude-sonnet-4-5
ANTHROPIC_API_KEY=

# OpenRouter (local default provider) — set this for real LLM runs
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# Bedrock options (when MODEL_PROVIDER=bedrock)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_REGION=ap-south-1

# ---- Store semantic search embeddings --------------------------------------
# bedrock | openai | fake
EMBEDDINGS_PROVIDER=fake
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ---- Execution tuning ------------------------------------------------------
N_JOBS_PER_WORKER=10
# BG_JOB_MAX_RETRIES=3            # native bg-run retry, resumes from checkpoint
# BG_JOB_TIMEOUT_SECS=86400
# LANGGRAPH_DEFAULT_RECURSION_LIMIT=10011
# BG_JOB_ISOLATED_LOOPS=True      # if graph nodes contain blocking sync code

# ---- TTLs (opt-in; deletes data!) ------------------------------------------
# LANGGRAPH_THREAD_TTL=10080      # minutes; or JSON: {"default_ttl": 60}

# ---- Webhooks (policy for per-assistant webhook URLs) ----------------------
# LANGGRAPH_WEBHOOKS={"url":{"allowed_domains":["hooks.example.com"],"require_https":true}}

# ---- Observability ----------------------------------------------------------
# LANGGRAPH_METRICS_ENABLED=true
# LANGGRAPH_METRICS_ENDPOINT=https://otlp-collector:4318   # OTLP export
# LS_APM_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# Tracing to LangSmith is DISABLED for data privacy. To enable anyway:
# LANGSMITH_TRACING=false

# ---- Watchdog (auto-recovery sidecar) ---------------------------------------
WATCHDOG_INTERVAL=30
WATCHDOG_STALE_SECS=900
WATCHDOG_MAX_ATTEMPTS=3

# ---- Test graph tuning ------------------------------------------------------
SLEEPY_SECS=45
